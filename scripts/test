#!/usr/bin/env python3
"""Plain test runner: runs every test_* function below, exits 1 on first failure."""
import os, sys, traceback

sys.dont_write_bytecode = True
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

HERE = os.path.dirname(os.path.abspath(__file__))


def load(name):
    """Load scripts/<name> (no .py) as a module, or None if it does not exist yet."""
    path = os.path.join(HERE, name)
    if not os.path.exists(path):
        return None
    loader = SourceFileLoader(name, path)
    mod = module_from_spec(spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


check = load("check")
sync = load("sync")

TD = lambda *c: "".join(f"<td>{x}</td>" for x in c)
IND, DESC = "<i>indisponível</i>", "<i>desconhecido</i>"


def row(cells, id_="e0001", attr=""):
    return f'<tr id="{id_}"{attr}>{TD(*cells)}</tr>'


EMPTY = row(["⬜", "0001", "Centro Doutor João dos Santos - Casa da Praia (IPSS)"] + [""] * 8)
FILLED_CELLS = ["✅", "0001", "Centro X", "Cascais", "Lisboa", "Rua X 12, 2750-000 Cascais",
                "clinica educacao", "Intervenção precoce", "https://example.pt",
                "geral@example.pt", "+351 212 345 678"]


def filled(**over):
    c = list(FILLED_CELLS)
    for k, v in over.items():
        c[int(k[1:])] = v
    return row(c)


def test_check_row_accepts():
    for line in [
        EMPTY,
        filled(),
        row(["✅", "0001", "Centro X", IND, DESC, IND, DESC, IND, IND, IND, IND]),
        filled(c2="Pais &amp; Filhos"),
        row(["⬜", "10000", "Grande"] + [""] * 8, id_="e10000"),
        row(["⬜", "0001", "Removida"] + [""] * 8, attr=' data-removed="1"'),
    ]:
        assert check.check_row(line) == [], (line, check.check_row(line))


def test_check_row_rejects():
    ok = FILLED_CELLS
    bad = {
        "10 cells": row(ok[:10]),
        "12 cells": row(ok + ["x"]),
        "bad status": filled(c0="❌"),
        "Nº mismatch": filled(c1="0002"),
        "filled empty cell": filled(c3=""),
        "empty Cidade on todo": row(["⬜", "0001", "N", "Lisboa"] + [""] * 7),
        "unknown slug": filled(c6="clinica foo"),
        "duplicate slug": filled(c6="clinica clinica"),
        "desconhecido + slug": filled(c6="clinica " + DESC),
        "desconhecido in Cidade": filled(c3=DESC),
        "bad website": filled(c8="ftp://x"),
        "bad email": filled(c9="a@b"),
        "phone no plus": filled(c10="212345678"),
        "raw &": filled(c2="A & B"),
        "raw <": filled(c2="A < B"),
        "leading space": " " + filled(),
    }
    for name, line in bad.items():
        assert check.check_row(line), name


def test_check_file(tmp=None):
    import tempfile
    def run(lines):
        with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False, encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        try:
            return check.check_file(f.name)
        finally:
            os.unlink(f.name)
    r1 = row(["⬜", "0001", "A"] + [""] * 8, id_="e0001")
    r2 = row(["⬜", "0002", "B"] + [""] * 8, id_="e0002")
    assert run(["<tbody>", r1, r2, "</tbody>"]) == []
    assert run([r2, r1])
    assert run([r1, r1])
    assert run([r1, "<tr id=\"e0002\"><td>x</td></tr>"])


def main():
    tests = [(n, f) for n, f in sorted(globals().items()) if n.startswith("test_") and callable(f)]
    for name, fn in tests:
        try:
            fn()
        except Exception:
            print(f"FAIL {name}")
            traceback.print_exc()
            sys.exit(1)
        print(f"ok   {name}")
    print(f"{len(tests)} tests passed")


if __name__ == "__main__":
    main()
