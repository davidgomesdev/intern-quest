#!/usr/bin/env python3
"""Plain test runner: runs every test_* function below, exits 1 on first failure."""
import os, sys, traceback

sys.dont_write_bytecode = True
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

HERE = os.path.dirname(os.path.abspath(__file__))


def load(name):
    """Load scripts/<name> (no .py) as a module, or None if it does not exist yet."""
    path = os.path.join(HERE, name)
    if not os.path.exists(path):
        return None
    loader = SourceFileLoader(name, path)
    mod = module_from_spec(spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


check = load("check")
sync = load("sync")

TD = lambda *c: "".join(f"<td>{x}</td>" for x in c)
IND, DESC = "<i>indisponível</i>", "<i>desconhecido</i>"


def row(cells, id_="e0001", attr=""):
    return f'<tr id="{id_}"{attr}>{TD(*cells)}</tr>'


EMPTY = row(["⬜", "0001", "Centro Doutor João dos Santos - Casa da Praia (IPSS)"] + [""] * 8)
FILLED_CELLS = ["✅", "0001", "Centro X", "Cascais", "Lisboa", "Rua X 12, 2750-000 Cascais",
                "clinica educacao", "Intervenção precoce", "https://example.pt",
                "geral@example.pt", "+351 212 345 678"]


def filled(**over):
    c = list(FILLED_CELLS)
    for k, v in over.items():
        c[int(k[1:])] = v
    return row(c)


def test_check_row_accepts():
    for line in [
        EMPTY,
        filled(),
        row(["✅", "0001", "Centro X", IND, DESC, IND, DESC, IND, IND, IND, IND]),
        filled(c2="Pais &amp; Filhos"),
        row(["⬜", "10000", "Grande"] + [""] * 8, id_="e10000"),
        row(["⬜", "0001", "Removida"] + [""] * 8, attr=' data-removed="1"'),
    ]:
        assert check.check_row(line) == [], (line, check.check_row(line))


def test_check_row_rejects():
    ok = FILLED_CELLS
    bad = {
        "10 cells": row(ok[:10]),
        "12 cells": row(ok + ["x"]),
        "bad status": filled(c0="❌"),
        "Nº mismatch": filled(c1="0002"),
        "filled empty cell": filled(c3=""),
        "empty Cidade on todo": row(["⬜", "0001", "N", "Lisboa"] + [""] * 7),
        "unknown slug": filled(c6="clinica foo"),
        "duplicate slug": filled(c6="clinica clinica"),
        "desconhecido + slug": filled(c6="clinica " + DESC),
        "desconhecido in Cidade": filled(c3=DESC),
        "bad website": filled(c8="ftp://x"),
        "bad email": filled(c9="a@b"),
        "phone no plus": filled(c10="212345678"),
        "raw &": filled(c2="A & B"),
        "raw <": filled(c2="A < B"),
        "leading space": " " + filled(),
    }
    for name, line in bad.items():
        assert check.check_row(line), name


def test_check_file(tmp=None):
    import tempfile
    def run(lines):
        with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False, encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        try:
            return check.check_file(f.name)
        finally:
            os.unlink(f.name)
    r1 = row(["⬜", "0001", "A"] + [""] * 8, id_="e0001")
    r2 = row(["⬜", "0002", "B"] + [""] * 8, id_="e0002")
    assert run(["<tbody>", r1, r2, "</tbody>"]) == []
    assert run([r2, r1])
    assert run([r1, r1])
    assert run([r1, "<tr id=\"e0002\"><td>x</td></tr>"])


def diff(*pairs, extra=()):
    """Build a --unified=0 diff of index.html from (old, new) pairs; None = no line."""
    out = ["diff --git a/index.html b/index.html", "index 1..2 100644",
           "--- a/index.html", "+++ b/index.html"]
    for i, (o, n) in enumerate(pairs, 1):
        out.append(f"@@ -{i} +{i} @@")
        if o is not None:
            out.append("-" + o)
        if n is not None:
            out.append("+" + n)
    for o, n in extra:
        out.append("@@ -99 +99 @@")
        out += ["-" + o, "+" + n]
    return "\n".join(out) + "\n"


def test_check_diff():
    cd = check.check_diff
    R = lambda n, status="⬜", name="N", attr="": row(
        [status, n, name] + ([""] * 8 if status == "⬜" else FILLED_CELLS[3:]),
        id_="e" + n, attr=attr)
    r1, r2 = R("0001"), R("0002")
    f1, f2 = R("0001", "✅"), R("0002", "✅")
    html = ["index.html"]
    # entity mode
    assert cd(diff((r1, f1)), html, None) == []
    assert cd(diff((r1, f1)), html, "feat/e0001-fill") == []
    assert cd(diff((r1, f1)), html, "feat/e0002-fill")
    assert cd(diff((r1, f1), (r2, f2)), html, None)
    assert cd(diff((r1, R("0001", "✅", name="Other"))), html, None)
    assert cd(diff((r1, R("0001", "✅", attr=' data-removed="1"'))), html, None)
    assert cd(diff((r1, f1), extra=[("<p>a</p>", "<p>b</p>")]), html, None)
    assert cd(diff((r1, f1)), ["index.html", "app.js"], None)
    assert cd(diff((r1, filled(c3="")), ), html, None)  # invalid filled row
    # sync mode
    assert cd(diff((None, r2)), html, None) == []
    assert cd(diff((r1, R("0001", attr=' data-removed="1"'))), html, None) == []
    assert cd(diff((R("0001", attr=' data-removed="1"'), r1)), html, None) == []
    assert cd(diff((None, f2)), html, None)
    # sync mode judges only row lines
    assert cd(diff((None, r2), extra=[("<p>a</p>", "<p>b</p>")]), ["index.html", "app.js"], None) == []
    # brand-new index.html (diff from /dev/null)
    new = "\n".join(["diff --git a/index.html b/index.html", "new file mode 100644",
                    "--- /dev/null", "+++ b/index.html", "@@ -0,0 +1,5 @@",
                    "+<!doctype html>", "+<table>", "+" + r1, "+" + r2, "+</table>"]) + "\n"
    assert cd(new, ["index.html", "scripts/check"], None) == []
    assert cd(new.replace("+" + r2, "+" + f2), ["index.html"], None)
    assert cd(diff((r1, None)), html, None)
    assert cd(diff((None, R("0002", name=""))), html, None)
    assert cd(diff((None, r2), (r1, f1)), html, None)
    # no row change
    assert cd("", ["app.js"], None) == []
    assert cd(diff(extra=[("<p>a</p>", "<p>b</p>")]), ["index.html", "app.js"], None) == []


SHELL = os.path.join(os.path.dirname(HERE), "index.html")
FIX = os.path.join(os.path.dirname(HERE), "tests")


def _shell_lines():
    with open(SHELL, encoding="utf-8") as f:
        return f.read().split("\n")


def _opp(name):
    with open(os.path.join(FIX, name), encoding="utf-8") as f:
        return sync.parse_opp(f.read())


def _rows(lines):
    return [l for l in lines if l.startswith('<tr id="e')]


def _sync(lines, opp):
    return sync.sync_lines(lines, opp, min_rows=1)


def test_sync_seed():
    shell = _shell_lines()
    assert _rows(shell) == []
    opp = _opp("opp-a.html")
    assert opp[9] == 'Escola A & B <Lda> "Café"'
    out, rep = _sync(shell, opp)
    rows = _rows(out)
    assert len(rows) == 3 and rep["new"] == [1, 4, 9] and rep["last_before"] is None and rep["last_after"] == 9
    for r in rows:
        assert r.count("<td>") == 11 and "⬜" in r and check.check_row(r) == [], r
    assert rows[2] == sync.row_line(9, 'Escola A & B <Lda> "Café"')
    assert "Escola A &amp; B &lt;Lda&gt; \"Café\"" in rows[2]
    assert [l for l in out if not l.startswith("<tr")] == shell
    out2, rep2 = _sync(out, opp)
    assert out2 == out and not (rep2["new"] or rep2["removed"] or rep2["readded"] or rep2["renamed"])


def test_sync_update():
    a, b = _opp("opp-a.html"), _opp("opp-b.html")
    seeded, _ = _sync(_shell_lines(), a)
    out, rep = _sync(seeded, b)
    ids = [int(l[9:l.index('"', 9)]) for l in _rows(out)]
    assert ids == [1, 2, 4, 9, 12, 13], ids
    assert rep["new"] == [2, 12, 13] and rep["removed"] == [4] and rep["readded"] == []
    assert rep["renamed"] == [(1, "Centro Alfa", "Centro Alfa, Lda.")]
    assert rep["last_before"] == 9 and rep["last_after"] == 13
    by = {int(l[9:l.index('"', 9)]): l for l in _rows(out)}
    assert by[4].startswith('<tr id="e0004" data-removed="1">') and check.check_row(by[4]) == []
    assert by[1] in seeded and "Centro Alfa</td>" in by[1]
    assert "Santa Casa X" in by[12] and "Santa Casa X" in by[13]
    for l in by.values():
        assert check.check_row(l) == [], l
    out2, rep2 = _sync(out, b)
    assert out2 == out and rep2["removed"] == [] and rep2["new"] == []


def test_sync_readd():
    a, b = _opp("opp-a.html"), _opp("opp-b.html")
    seeded, _ = _sync(_shell_lines(), a)
    gone, _ = _sync(seeded, b)
    back, rep = _sync(gone, a)
    assert rep["readded"] == [4] and rep["removed"] == [2, 12, 13]
    row4 = [l for l in back if l.startswith('<tr id="e0004"')][0]
    assert "data-removed" not in row4
    assert [l for l in back if l.startswith('<tr id="e0002"')][0].startswith('<tr id="e0002" data-removed="1">')


def test_sync_abort():
    import subprocess, tempfile
    seeded, _ = _sync(_shell_lines(), _opp("opp-a.html"))
    try:
        sync.sync_lines(seeded, {}, min_rows=1)
        assert False, "expected ValueError"
    except ValueError:
        pass
    with tempfile.TemporaryDirectory() as d:
        f = os.path.join(d, "index.html")
        with open(f, "w", encoding="utf-8") as fh:
            fh.write("\n".join(seeded))
        before = open(f, "rb").read()
        empty = os.path.join(d, "empty.html")
        with open(empty, "w") as fh:
            fh.write("<html><body></body></html>")
        r = subprocess.run([sys.executable, os.path.join(HERE, "sync"), "--from", empty, "--file", f, "--min-rows", "1"],
                           capture_output=True, text=True)
        assert r.returncode == 1, r
        assert open(f, "rb").read() == before
        # CLI happy path: writes, then no-op
        a = os.path.join(FIX, "opp-b.html")
        cmd = [sys.executable, os.path.join(HERE, "sync"), "--from", a, "--file", f, "--min-rows", "1"]
        r = subprocess.run(cmd, capture_output=True, text=True)
        assert r.returncode == 0 and "+3 new" in r.stdout and "-1 removed" in r.stdout and "~1 renamed" in r.stdout, r.stdout
        mid = open(f, "rb").read()
        assert mid != before
        r = subprocess.run(cmd, capture_output=True, text=True)
        assert r.returncode == 0 and "+0 new" in r.stdout and open(f, "rb").read() == mid


def test_sync_wide_id():
    out, rep = _sync(_shell_lines(), {9999: "Nove", 10000: "Dez mil"})
    rows = _rows(out)
    assert 'id="e9999"' in rows[0] and 'id="e10000"' in rows[1]
    assert all(check.check_row(r) == [] for r in rows)
    assert _sync(out, {9999: "Nove", 10000: "Dez mil"})[0] == out


def main():
    tests = [(n, f) for n, f in sorted(globals().items()) if n.startswith("test_") and callable(f)]
    for name, fn in tests:
        try:
            fn()
        except Exception:
            print(f"FAIL {name}")
            traceback.print_exc()
            sys.exit(1)
        print(f"ok   {name}")
    print(f"{len(tests)} tests passed")


if __name__ == "__main__":
    main()
